# Host ports
API_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL development database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
DATABASE_URL=postgresql://app:app@postgres:5432/app?schema=public

# Development-only authentication secrets
AUTH_ACCESS_TOKEN_SECRET=development-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_HASH_SECRET=development-refresh-token-secret-change-me
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# HTTP and observability
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info
DOCS_ENABLED=true
DOCS_OPENAPI_PATH=/openapi.json
DOCS_REFERENCE_PATH=/reference

