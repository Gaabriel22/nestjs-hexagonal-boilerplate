# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Authentication
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_HASH_SECRET=replace-with-at-least-32-characters
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# HTTP policy
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=info

# API documentation
DOCS_ENABLED=true
DOCS_OPENAPI_PATH=/openapi.json
DOCS_REFERENCE_PATH=/reference
