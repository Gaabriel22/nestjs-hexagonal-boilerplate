# Application
HOST=0.0.0.0
PORT=3000

# Inject real production values at runtime
DATABASE_URL=postgresql://app:replace-me@postgres:5432/app?schema=public
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# HTTP and observability
CORS_ORIGINS=https://example.com
HTTP_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=info
DOCS_ENABLED=false
DOCS_OPENAPI_PATH=/openapi.json
DOCS_REFERENCE_PATH=/reference

